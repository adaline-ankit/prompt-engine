{
  "manifest_version": 3,
  "name": "Vibe Prompt Engine",
  "version": "0.1.3",
  "description": "Optimize prompts from the browser before sending them to an LLM.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://prompt-engine-mcp-pewnieev4a-el.a.run.app/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Vibe Prompt Engine",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
